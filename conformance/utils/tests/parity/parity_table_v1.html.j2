<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title|e }}</title>
<style>
{{ conformance_css }}
/* v1 parity-page-only overrides; everything else is the shared conformance.css */
td.cell { text-align: center; min-width: 24px; font-weight: 400; }
.view-overview td.cell > a { color: inherit; }
.versions { color: #555; font-size: 12px; margin-top: 0.2em; }
.summary-key.na { background: #d3d8de; }
</style>
</head>
<body class="view-overview">
<h1>{{ title|e }}</h1>
<p class="generated">
  Auto-generated on {{ stamp|e }}{% if sha %} on commit <a href="https://github.com/ai-dynamo/frontend-crates/commit/{{ sha|e }}"><code>{{ short_sha|e }}</code></a>{% endif %}:
  <code>{{ command|e }} &gt; {{ output|e }}</code>
</p>
{% if intro_html is defined and intro_html %}
{{ intro_html|safe }}
{% endif %}
{% if model_json is defined and model_json %}
<script type="application/json" id="conformance-model">{{ model_json|safe }}</script>
{% endif %}
{% if conformance_view_js is defined and conformance_view_js %}
{# JS view (DIS-2434): builds the DOM from the model blob BEFORE conformance.js wires it. #}
<script>
{{ conformance_view_js }}
</script>
{% endif %}
<script>
{{ conformance_js }}
</script>
</body>
</html>
