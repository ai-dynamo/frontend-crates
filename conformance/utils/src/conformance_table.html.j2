<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title|e }}</title>
<style>
{{ conformance_css|safe }}
</style>
</head>
<body class="view-overview parser-dynamo_rust cmp-loading">
<div class="cmp-loading-note">loading&hellip; applying the compare model (colors are not final)</div>
<h1>{% if title_html is defined and title_html %}{{ title_html|safe }}{% else %}{{ title|e }}{% endif %}</h1>
<p class="generated">
  Auto-generated on {{ stamp|e }}{% if sha %} on commit <a href="https://github.com/ai-dynamo/frontend-crates/commit/{{ sha|e }}"><code>{{ short_sha|e }}</code></a>{% endif %}:
  <code>{{ command|e }} &gt; {{ output|e }}</code>
</p>
{% if model_json is defined and model_json %}
<script type="application/json" id="conformance-model">{{ model_json|safe }}</script>
{% endif %}
<script>window.__PARSER_NI = {{ parser_ni_json|safe }};</script>
{% if conformance_view_js is defined and conformance_view_js %}
{# JS view (DIS-2434): builds the DOM from the model blob BEFORE conformance.js wires it. #}
<script>
{{ conformance_view_js|safe }}
</script>
{% endif %}
<script>
{{ conformance_js|safe }}
</script>
</body>
</html>
