# Conformance fixture shards are stored in Git LFS (binary tarballs).
conformance/fixtures/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text

# Captured evidence stays byte-exact; review authored YAML and code as text.
conformance/fixtures-unified-v2/families/*/*.yaml -diff -text linguist-generated=true
conformance/fixtures-unified-v2/families/*/inputs_and_golden.yaml diff text linguist-generated=false
conformance/fixtures-unified-v2/executions/*.yaml -diff -text linguist-generated=true
conformance/fixtures-unified-v2/receipts/*.yaml -diff -text linguist-generated=true
conformance/fixtures-unified-v2/versions/*.tar.gz binary linguist-generated=true
